<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HotelLuxoEstilizado.Views.SobrePage"
    Title="Sobre"
    BackgroundColor="#F5F5F5">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Image
                Source="developer.png"
                HeightRequest="150"
                WidthRequest="150"
                HorizontalOptions="Center"/>

            <Label
                Text="HotelLuxoEstilizado"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#0F4C81"/>

            <Frame
                CornerRadius="15"
                BackgroundColor="White">

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Desenvolvedor"
                        TextColor="Black"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Lucas Moraes"
                        TextColor="Black"/>

                    <Label
                        Text="Curso Técnico em Desenvolvimento de Sistemas"
                        TextColor="Black"/>

                </VerticalStackLayout>

            </Frame>

            <Frame
                CornerRadius="15"
                BackgroundColor="White">

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Informações do Projeto"
                        TextColor="Black"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Versão 1.0"
                        TextColor="Black"/>

                    <Label
                        Text="Ano de Desenvolvimento: 2026"
                        TextColor="Black"/>

                    <Label
                        Text="Tecnologia: .NET MAUI"
                        TextColor="Black"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>