<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HotelLuxoEstilizado.Views.MainPage"
    Title="HotelLuxoEstilizado"
    BackgroundColor="#F5F5F5">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Image
                Source="hotel.jpeg"
                HeightRequest="220"
                Aspect="AspectFill" />

            <Label
                Text="HotelLuxoEstilizado"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#0F4C81"
                HorizontalOptions="Center"/>

            <Frame
                CornerRadius="15"
                BackgroundColor="White">

                <VerticalStackLayout
                    Padding="15"
                    Spacing="10">

                    <Label
                        Text="Quantidade de Hóspedes"
                        TextColor="Black"
                        FontAttributes="Bold"/>
                    

                    <Stepper
                        Minimum="1"
                        Maximum="10"
                        Increment="1"/>

                    <Label
                        Text="Data de Entrada"
                        TextColor="Black"
                        FontAttributes="Bold"/>

                    <DatePicker
                        Format="dd/MM/yyyy"/>

                    <Label
                        Text="Data de Saída"
                        TextColor="Black"
                        FontAttributes="Bold"/>

                    <DatePicker
                        Format="dd/MM/yyyy"/>

                    <Label
                        Text="Tipo de Quarto"
                        TextColor="Black"
                        FontAttributes="Bold"/>

                    <Picker Title="Selecione um quarto">

                        <Picker.Items>
                            <x:String>Standard</x:String>
                            <x:String>Luxo</x:String>
                            <x:String>Premium</x:String>
                        </Picker.Items>

                    </Picker>

                    <Button
                        Text="Reservar"
                        BackgroundColor="#0F4C81"
                        TextColor="White"
                        CornerRadius="15"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>